[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = false

[libraries]
linux.debug.x86_64 = "res://../../target/release/librdai_godot.so"
linux.release.x86_64 = "res://../../target/release/librdai_godot.so"
macos.debug = "res://../../target/release/librdai_godot.dylib"
macos.release = "res://../../target/release/librdai_godot.dylib"
windows.debug.x86_64 = "res://../../target/release/rdai_godot.dll"
windows.release.x86_64 = "res://../../target/release/rdai_godot.dll"
